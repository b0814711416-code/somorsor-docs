---
/**
 * หน้าเปลี่ยนรหัสผ่าน
 * - ถูกบังคับเข้ามาเมื่อเข้าระบบครั้งแรก (รหัส 123456) หรือ admin รีเซ็ตรหัส
 * - ผู้ใช้ทั่วไปเข้ามาเปลี่ยนเองได้จากเมนูด้านข้าง
 */
import { getSession } from '../lib/auth';

const session = await getSession(Astro.request);
if (!session) return Astro.redirect('/login');

const forced = Boolean(session.mustChangePassword);
---
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>เปลี่ยนรหัสผ่าน — Admin สมศ.</title>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>body { font-family: 'Sarabun', sans-serif; }</style>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-900 to-blue-700 flex items-center justify-center p-4">

  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-2xl p-8">

      <div class="text-center mb-6">
        <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <span class="text-3xl">🔑</span>
        </div>
        <h1 class="text-xl font-bold text-gray-800">ตั้งรหัสผ่านใหม่</h1>
        <p class="text-sm text-gray-500 mt-1">ชื่อผู้ใช้: <span class="font-semibold text-gray-700">{session.email}</span></p>
      </div>

      {forced && (
        <div class="mb-5 p-3 bg-amber-50 border border-amber-200 rounded-lg">
          <p class="text-sm text-amber-800">
            คุณกำลังใช้รหัสผ่านเริ่มต้น กรุณาตั้งรหัสผ่านใหม่ก่อนเข้าใช้งานระบบ
          </p>
        </div>
      )}

      <form id="pwForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            รหัสผ่านปัจจุบัน {forced && <span class="text-gray-400 text-xs">(123456)</span>}
          </label>
          <input id="current" type="password" required autocomplete="current-password"
                 class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">รหัสผ่านใหม่</label>
          <input id="next" type="password" required minlength="8" autocomplete="new-password"
                 placeholder="อย่างน้อย 8 ตัวอักษร"
                 class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">ยืนยันรหัสผ่านใหม่</label>
          <input id="confirm" type="password" required minlength="8" autocomplete="new-password"
                 class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>

        <p id="errorMsg" class="hidden text-sm text-red-600"></p>

        <button type="submit" id="submitBtn"
                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-colors disabled:opacity-60">
          บันทึกรหัสผ่านใหม่
        </button>
      </form>

      <div class="mt-5 flex justify-between text-sm">
        {forced ? <span></span> : <a href="/" class="text-gray-500 hover:text-blue-600">← กลับหน้าหลัก</a>}
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="text-gray-500 hover:text-red-600">ออกจากระบบ</button>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const form      = document.getElementById('pwForm');
    const submitBtn = document.getElementById('submitBtn');
    const errorMsg  = document.getElementById('errorMsg');

    function showError(msg) {
      errorMsg.textContent = msg;
      errorMsg.classList.remove('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.add('hidden');

      const current = document.getElementById('current').value;
      const next    = document.getElementById('next').value;
      const confirm = document.getElementById('confirm').value;

      if (next !== confirm) return showError('รหัสผ่านใหม่และการยืนยันไม่ตรงกัน');
      if (next.length < 8)  return showError('รหัสผ่านใหม่ต้องมีอย่างน้อย 8 ตัวอักษร');
      if (next === '123456') return showError('ห้ามใช้รหัสผ่านเริ่มต้น 123456');

      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังบันทึก...';
      try {
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_password: current, new_password: next }),
        });
        const data = await res.json();
        if (res.ok) {
          window.location.href = '/';
        } else {
          showError(data.error || 'เกิดข้อผิดพลาด');
        }
      } catch {
        showError('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'บันทึกรหัสผ่านใหม่';
      }
    });
  </script>
</body>
</html>
